# ===== Dify 知识问答（Step 1 起使用）=====
# Dify 实例 API 基础地址（内网，末尾带 /v1）
DIFY_API_BASE=http://zkt.medlibbot.com:8380/v1

# Dify 应用 API Key（应用 → API 访问 → 创建密钥，形如 app-xxx）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

ENABLE_TTS=true

# ===== 语音链路 =====
# server = 本机 voice-service（127.0.0.1:8000）；browser 仅调试用（国内不可用）
NEXT_PUBLIC_VOICE_PROVIDER=server

# 方案 A：ASR 模式（Step 5 流式代码就绪后生效）
# batch = 录完再识别（当前）；stream = WebSocket 流式 + partial 导航
NEXT_PUBLIC_VOICE_ASR=batch

# 方案 A：VAD 引擎（Step 4 Silero 就绪后改为 silero）
NEXT_PUBLIC_VAD_ENGINE=energy

# 本机语音服务（Windows 下务必用 127.0.0.1，避免 localhost → IPv6 超时）
VOICE_SERVICE_URL=http://127.0.0.1:8000

# DashScope Key 放在 voice-service/.env，不要写进 NEXT_PUBLIC_（会暴露到浏览器）

# ===== VAD 阈值（energy 模式；Silero 模式下作备用）=====
NEXT_PUBLIC_VAD_FLOOR=0.008
NEXT_PUBLIC_VAD_START_K=2.2
NEXT_PUBLIC_VAD_END_K=1.6

# ===== 交互超时（毫秒）=====
NEXT_PUBLIC_IDLE_TIMEOUT_MS=35000
NEXT_PUBLIC_CHOICE_TIMEOUT_MS=15000
