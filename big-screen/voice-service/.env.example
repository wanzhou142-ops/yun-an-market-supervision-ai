# voice-service 环境变量（方案 A · Step 0）
# 用法：复制为 .env 并填入真实 Key（.env 不要提交 git）
#   copy .env.example .env
#
# 启动：start.bat / start.sh（server.py 会自动读取本目录 .env）

VOICE_SERVICE_PORT=8000

# 导航 KWS（sherpa-onnx · 默认开启，见 install-kws.bat）
KWS_ENABLED=true
KWS_WS_PORT=10096

# 流式 ASR（FunASR，旧路径；导航已改 KWS，保持 off）
ASR_STREAM=off
VOICE_WS_PORT=10095

# FunASR 流式（可选，见 requirements-funasr.txt）
# FUNASR_DEVICE=cpu
# FUNASR_STREAM_MODEL=iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online
# FUNASR_HOTWORDS=宣传廊,模拟药店,药品区

# ===== Step 3 推荐：CosyVoice TTS + Fun-ASR REST =====
ASR_BACKEND=dashscope
TTS_BACKEND=dashscope

# ===== 全离线回退（客户机无外网） =====
# ASR_BACKEND=vosk
# TTS_BACKEND=piper

# 阿里云百炼 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# cosyvoice-v3-flash 配 v3 音色（见百炼 CosyVoice 音色列表）
DASHSCOPE_ASR_MODEL=fun-asr-realtime
DASHSCOPE_ASR_LANGUAGE=zh
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanhuan
