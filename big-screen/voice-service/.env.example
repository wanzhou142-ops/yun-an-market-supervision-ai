# voice-service 环境变量（方案 A · Step 0）
# 用法：复制为 .env 并填入真实 Key（.env 不要提交 git）
#   copy .env.example .env
#
# 启动：start.bat / start.sh（server.py 会自动读取本目录 .env）

VOICE_SERVICE_PORT=8000

# ===== Step 2 当前配置：CosyVoice 动态 TTS + vosk ASR =====
ASR_BACKEND=vosk
TTS_BACKEND=dashscope

# ===== 全离线回退 =====
# ASR_BACKEND=vosk
# TTS_BACKEND=piper

# 阿里云百炼 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# cosyvoice-v3-flash 配 v3 音色（见百炼 CosyVoice 音色列表）
DASHSCOPE_ASR_MODEL=fun-asr-realtime
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanhuan
