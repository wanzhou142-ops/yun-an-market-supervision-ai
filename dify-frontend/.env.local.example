# ===== Dify 配置（当前大屏三场景未调用，保留给后续扩展/小智统一接口用）=====
# Dify 实例的 API 基础地址（内网实例，注意末尾带 /v1）
DIFY_API_BASE=http://zkt.medlibbot.com:8380/v1

# Dify 应用的 API Key（在 Dify 应用 → API 访问 → 生成）
# 形如 app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：是否自动语音播报 AI 回答（浏览器 TTS）
ENABLE_TTS=true

# ===== 语音链路 =====
# 语音提供商：server(默认, 走本机语音服务 voice-service 的 ASR+TTS) | browser(调试用,ASR 受限于国内网络)
NEXT_PUBLIC_VOICE_PROVIDER=server
# 本机语音服务地址（voice-service/server.py，默认 127.0.0.1:8000）
# 注意：Windows 下 Node 服务端 fetch "localhost" 可能解析到 IPv6 (::1)，而 voice-service
# 通常只监听 IPv4 (127.0.0.1)，会导致 4 秒超时 abort。因此默认优先 127.0.0.1。
VOICE_SERVICE_URL=http://127.0.0.1:8000
# 云端 ASR（可选，拿到 key 后启用；未配则 voice-service 走 mock 让整条链路可 demo）
# ASR_PROVIDER=mock            # mock | dashscope | xfyun | tencent
# DASHSCOPE_API_KEY=
# XFYUN_API_KEY=
