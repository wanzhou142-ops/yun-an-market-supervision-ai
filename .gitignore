# ========== 依赖 ==========
node_modules/

# ========== 构建产物 ==========
.next/
out/
dist/
build/

# ========== 环境变量 / 密钥（绝不提交！） ==========
# .env.local 含真实 Dify API Key，禁止入库
.env.local
.env
# 排除所有 .env.* 但放行示例文件（.env.example / .env.local.example）
.env.*
!.env.example
!.env.local.example

# ========== 打包 / 发布产物 ==========
*.zip
*.tar.gz
*.rar

# ========== 语音模型（体积大，用 voice-service/download_models 脚本下载） ==========
voice-service/models/
voice-service/__pycache__/
voice-service/debug/
voice-service/_probe/node_modules/

# ========== Python 缓存 ==========
__pycache__/
*.pyc
*.pyo

# ========== 编辑器 / 系统 ==========
.vscode/
.idea/
*.tsbuildinfo
npm-debug.log*
.DS_Store
Thumbs.db

# ========== 工具内部数据（含明文密钥/个人配置，禁止入库） ==========
.workbuddy/
.obsidian/

# ========== 资产原图备份（约 15MB，仅本地留档，可用 tools/ 脚本重新生成） ==========
assets-original/
preview/

